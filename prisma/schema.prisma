// MindDesk database schema — Hostinger MySQL.
// Connection string comes from the DATABASE_URL environment variable.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id           String     @id @default(uuid()) @db.Char(36)
  email        String     @unique @db.VarChar(255)
  passwordHash String     @map("password_hash") @db.VarChar(255)
  displayName  String?    @map("display_name") @db.VarChar(80)
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")
  sessions     Session[]
  lists        TaskList[]
  tasks        Task[]
  projects     Project[]
  pages        Page[]
  events       Event[]
  planCategories PlanCategory[]
  planActivities PlanActivity[]
  focusSessions  FocusSession[]
  mindMaps       MindMap[]
  habits         Habit[]
  routines       Routine[]
  habitCompletions HabitCompletion[]
  settings     UserSettings?

  @@map("users")
}

model Session {
  id        String   @id @default(uuid()) @db.Char(36)
  tokenHash String   @unique @map("token_hash") @db.Char(64)
  userId    String   @map("user_id") @db.Char(36)
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model TaskList {
  id        String   @id @default(uuid()) @db.Char(36)
  userId    String   @map("user_id") @db.Char(36)
  title     String   @db.VarChar(200)
  position  Float    @default(0)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tasks     Task[]

  @@index([userId, position])
  @@map("task_lists")
}

model Task {
  id             String    @id @default(uuid()) @db.Char(36)
  userId         String    @map("user_id") @db.Char(36)
  listId         String    @map("list_id") @db.Char(36)
  parentId       String?   @map("parent_id") @db.Char(36)
  title          String    @db.VarChar(500)
  description    String?   @db.Text
  completed      Boolean   @default(false)
  completedAt    DateTime? @map("completed_at")
  starred        Boolean   @default(false)
  dueDate        DateTime? @map("due_date") @db.Date
  recurrenceRule String?   @map("recurrence_rule") @db.VarChar(255)
  position       Float     @default(0)
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  list           TaskList  @relation(fields: [listId], references: [id], onDelete: Cascade)
  parent         Task?     @relation("Subtasks", fields: [parentId], references: [id], onDelete: Cascade)
  subtasks       Task[]    @relation("Subtasks")

  @@index([userId])
  @@index([listId])
  @@index([parentId])
  @@map("tasks")
}

model Project {
  id        String   @id @default(uuid()) @db.Char(36)
  userId    String   @map("user_id") @db.Char(36)
  title     String   @db.VarChar(200)
  position  Float    @default(0)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  pages     Page[]

  @@index([userId, position])
  @@map("projects")
}

/// A page is a personal note (projectId = null) or a page inside a project.
/// `content` is JSON text: { "blocks": [{ id, type: "p"|"check"|"number"|"bullet", text, checked? }] }
model Page {
  id        String   @id @default(uuid()) @db.Char(36)
  userId    String   @map("user_id") @db.Char(36)
  projectId String?  @map("project_id") @db.Char(36)
  parentId  String?  @map("parent_id") @db.Char(36)
  title     String   @default("") @db.VarChar(300)
  content   String   @db.LongText
  version   Int      @default(1)
  position  Float    @default(0)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  project   Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)
  parent    Page?    @relation("Subpages", fields: [parentId], references: [id], onDelete: Cascade)
  children  Page[]   @relation("Subpages")

  @@index([userId, projectId])
  @@index([parentId])
  @@map("pages")
}

/// Calendar event. Timed events: start_at/end_at are UTC instants.
/// All-day events: start_at/end_at hold the calendar dates at 00:00 UTC (end date inclusive) — no time-zone shift.
/// recurrence_rule is a single RRULE such as "FREQ=WEEKLY"; occurrences are expanded at read time.
model Event {
  id             String   @id @default(uuid()) @db.Char(36)
  userId         String   @map("user_id") @db.Char(36)
  title          String   @db.VarChar(300)
  description    String?  @db.Text
  location       String?  @db.VarChar(300)
  startAt        DateTime @map("start_at")
  endAt          DateTime @map("end_at")
  allDay         Boolean  @default(false) @map("all_day")
  color          String   @default("blue") @db.VarChar(20)
  recurrenceRule String?  @map("recurrence_rule") @db.VarChar(255)
  timeZone       String   @default("Asia/Kolkata") @map("time_zone") @db.VarChar(64)
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, startAt])
  @@map("events")
}

/// Plan Your Day category (five defaults per user are created on first use; defaults can't be deleted).
model PlanCategory {
  id         String         @id @default(uuid()) @db.Char(36)
  userId     String         @map("user_id") @db.Char(36)
  name       String         @db.VarChar(60)
  color      String         @db.VarChar(20)
  position   Float          @default(0)
  isDefault  Boolean        @default(false) @map("is_default")
  createdAt  DateTime       @default(now()) @map("created_at")
  updatedAt  DateTime       @updatedAt @map("updated_at")
  user       User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  activities PlanActivity[]

  @@index([userId, position])
  @@map("plan_categories")
}

/// Time block. Wall-clock minutes (0-1440) of a local day; end <= start means overnight.
/// repeat_days is a weekday bitmask (bit 0 = Sunday); 0 = one-off on start_date. No per-day rows.
model PlanActivity {
  id          String                  @id @default(uuid()) @db.Char(36)
  userId      String                  @map("user_id") @db.Char(36)
  categoryId  String?                 @map("category_id") @db.Char(36)
  title       String                  @db.VarChar(200)
  description String?                 @db.Text
  startDate   DateTime                @map("start_date") @db.Date
  endDate     DateTime?               @map("end_date") @db.Date
  startMinute Int                     @map("start_minute") @db.SmallInt
  endMinute   Int                     @map("end_minute") @db.SmallInt
  repeatDays  Int                     @default(0) @map("repeat_days") @db.TinyInt
  routineType String                  @default("fixed") @map("routine_type") @db.VarChar(10)
  createdAt   DateTime                @default(now()) @map("created_at")
  updatedAt   DateTime                @updatedAt @map("updated_at")
  user        User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  category    PlanCategory?           @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  exceptions  PlanActivityException[]
  focus       FocusSession[]

  @@index([userId, startDate])
  @@index([categoryId])
  @@map("plan_activities")
}

/// Per-day override of a recurring activity: moved times or skipped (cancelled) for one date.
model PlanActivityException {
  id          String       @id @default(uuid()) @db.Char(36)
  activityId  String       @map("activity_id") @db.Char(36)
  date        DateTime     @db.Date
  cancelled   Boolean      @default(false)
  startMinute Int?         @map("start_minute") @db.SmallInt
  endMinute   Int?         @map("end_minute") @db.SmallInt
  createdAt   DateTime     @default(now()) @map("created_at")
  activity    PlanActivity @relation(fields: [activityId], references: [id], onDelete: Cascade)

  @@unique([activityId, date])
  @@map("plan_activity_exceptions")
}

model FocusSession {
  id             String        @id @default(uuid()) @db.Char(36)
  userId         String        @map("user_id") @db.Char(36)
  activityId     String?       @map("activity_id") @db.Char(36)
  title          String        @db.VarChar(200)
  date           DateTime      @db.Date
  plannedMinutes Int           @map("planned_minutes") @db.SmallInt
  focusedSeconds Int           @map("focused_seconds")
  completed      Boolean       @default(false)
  startedAt      DateTime      @map("started_at")
  endedAt        DateTime      @map("ended_at")
  createdAt      DateTime      @default(now()) @map("created_at")
  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  activity       PlanActivity? @relation(fields: [activityId], references: [id], onDelete: SetNull)

  @@index([userId, date])
  @@index([activityId])
  @@map("focus_sessions")
}

/// Mind map. `data` is one validated JSON document {layout, nodes[], links[]} (see src/lib/mindmap-doc.ts)
/// holding topics, hierarchy, manual coordinates, styles and custom connections. Saved atomically with
/// optimistic concurrency on `version`.
model MindMap {
  id        String   @id @default(uuid()) @db.Char(36)
  userId    String   @map("user_id") @db.Char(36)
  title     String   @db.VarChar(200)
  data      String   @db.LongText
  nodeCount Int      @default(1) @map("node_count")
  version   Int      @default(1)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, updatedAt])
  @@map("mind_maps")
}

/// Habits & Routines. A routine groups habits (a habit belongs to at most one routine).
/// Deleting a routine keeps its habits (routine_id → NULL) and their history.
model Routine {
  id        String   @id @default(uuid()) @db.Char(36)
  userId    String   @map("user_id") @db.Char(36)
  title     String   @db.VarChar(200)
  position  Float    @default(0)
  collapsed Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  habits    Habit[]

  @@index([userId, position])
  @@map("routines")
}

/// repeat_days is a weekday bitmask (bit 0 = Sunday). start_date is the first tracked day (app time zone).
model Habit {
  id          String            @id @default(uuid()) @db.Char(36)
  userId      String            @map("user_id") @db.Char(36)
  routineId   String?           @map("routine_id") @db.Char(36)
  title       String            @db.VarChar(200)
  description String?           @db.Text
  color       String            @default("blue") @db.VarChar(20)
  repeatDays  Int               @default(127) @map("repeat_days") @db.TinyInt
  position    Float             @default(0)
  startDate   String            @map("start_date") @db.Char(10)
  createdAt   DateTime          @default(now()) @map("created_at")
  updatedAt   DateTime          @updatedAt @map("updated_at")
  user        User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  routine     Routine?          @relation(fields: [routineId], references: [id], onDelete: SetNull)
  completions HabitCompletion[]

  @@index([userId, position])
  @@index([routineId])
  @@map("habits")
}

/// One row per completed (habit, local date). The date is the literal "YYYY-MM-DD" key — never shifted by UTC.
model HabitCompletion {
  id        String   @id @default(uuid()) @db.Char(36)
  userId    String   @map("user_id") @db.Char(36)
  habitId   String   @map("habit_id") @db.Char(36)
  date      String   @db.Char(10)
  createdAt DateTime @default(now()) @map("created_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  habit     Habit    @relation(fields: [habitId], references: [id], onDelete: Cascade)

  @@unique([userId, habitId, date])
  @@index([habitId])
  @@map("habit_completions")
}

model UserSettings {
  userId    String   @id @map("user_id") @db.Char(36)
  data      String   @db.Text
  updatedAt DateTime @updatedAt @map("updated_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_settings")
}
