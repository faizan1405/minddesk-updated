# MindDesk — production environment (copy to Hostinger's Environment Variables panel).
# Never commit real values.

# Hostinger MySQL connection string:
# mysql://USER:PASSWORD@HOST:3306/DATABASE
# URL-encode special characters in the password (e.g. @ -> %40).
DATABASE_URL="mysql://u123_minddesk:CHANGE_ME@localhost:3306/u123_minddesk"

NODE_ENV=production
# PORT is provided by Hostinger automatically; set only if required.
# PORT=3000

# Owner account setup (one-time bootstrap on empty database):
# Set these in Hostinger Environment Variables before first launch.
# The server bootstraps this account into the users table at runtime.
# Once created, ADMIN_PASSWORD can be safely removed.
ADMIN_EMAIL="owner@example.com"
ADMIN_PASSWORD="CHANGE_ME_SECURE_PASSWORD"

# Recycle Bin 30-day auto-cleanup secret (optional, used if triggering cleanup via HTTP webhook):
# curl -X POST https://yourdomain.com/api/trash/cleanup -H "Authorization: Bearer YOUR_CRON_SECRET"
CRON_SECRET="CHANGE_ME_TO_A_RANDOM_LONG_SECRET"
